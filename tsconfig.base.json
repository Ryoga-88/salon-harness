{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@salon-harness/shared": ["./packages/shared/src/index.ts"],
      "@salon-harness/salon-domain": ["./packages/salon-domain/src/index.ts"],
      "@salon-harness/sdk": ["./packages/sdk/src/index.ts"]
    }
  }
}
